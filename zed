{
	"vim_mode": true,
	"vim": {
		"toggle_relative_line_numbers": true,
	},
	"relative_line_numbers": "enabled",
	"edit_predictions": {
		"provider": "zed",
	},
	"project_panel": {
		"dock": "right",
	},
	"ui_font_size": 16,
	"buffer_font_family": "Zed Plex Mono",
	"buffer_font_size": 18,
	"buffer_font_weight": 501,
	"buffer_line_height": {
		"custom": 2,
	},
	"theme": {
		"mode": "dark",
		"dark": "One Dark",
		"light": "One Light",
	},
	"format_on_save": "on",
	"tab_size": 4,
	"hard_tabs": true,
}
